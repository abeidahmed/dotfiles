#!/usr/bin/env bash
set -euo pipefail

# work-worktree — create a git worktree for a branch and initialize it for local dev.
#
# Usage:
#   work-worktree <branch> [suffix]
#
# Creates a sibling worktree dir named "<repo>-<suffix>" next to the main repo,
# then: symlinks config/master.key from the main repo, bundle install,
# yarn install, and bundle exec rails db:test:prepare.
#
# If <suffix> is omitted it is derived from the trailing digits of the branch
# name (e.g. aa/fix-scenario-042 -> 042), falling back to a sanitized branch
# basename. If the branch already exists it is checked out; otherwise it is
# created with -b.
#
# Run from anywhere inside the repo (main worktree or an existing worktree).

die() { echo "work-worktree: $*" >&2; exit 1; }

# Name the failing step on any abort instead of dying silently.
trap 'echo "work-worktree: FAILED near line $LINENO (see output above)" >&2' ERR

[[ $# -ge 1 ]] || die "usage: work-worktree <branch> [suffix]"

branch="$1"
suffix="${2:-}"

# Locate the main worktree root via the shared git dir.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_root="$(dirname "$common_dir")"
repo_name="$(basename "$main_root")"
parent_dir="$(dirname "$main_root")"

# Derive a directory suffix if none was given.
if [[ -z "$suffix" ]]; then
  if [[ "$branch" =~ ([0-9]+)$ ]]; then
    suffix="${BASH_REMATCH[1]}"
  else
    suffix="$(basename "$branch" | tr -c 'A-Za-z0-9._-' '-')"
  fi
fi

worktree_dir="$parent_dir/$repo_name-$suffix"
[[ ! -e "$worktree_dir" ]] || die "target already exists: $worktree_dir"

master_key_src="$main_root/config/master.key"
[[ -e "$master_key_src" ]] || die "master.key not found at $master_key_src"

echo "==> Creating worktree $worktree_dir on branch $branch"
if git -C "$main_root" show-ref --verify --quiet "refs/heads/$branch"; then
  git -C "$main_root" worktree add "$worktree_dir" "$branch"
else
  git -C "$main_root" worktree add "$worktree_dir" -b "$branch"
fi

echo "==> Symlinking config/master.key"
# Absolute target on purpose: relative targets break because a worktree sits one
# directory deeper than a naive "../<repo>/config/master.key" assumes.
ln -sfn "$master_key_src" "$worktree_dir/config/master.key"

# Give this worktree its own test database + advisory-lock namespace via
# TEST_ENV_NUMBER (see config/initializers/sequenced.rb and the test: block in
# config/database.yml -> ambiki_test<TEST_ENV_NUMBER>). Written to .env.test so
# it applies only in the test environment, keeping development/production blank.
# Derived from the dir suffix (stripped to alphanumerics for a valid db name) so
# it is stable per worktree and unique across worktrees.
test_env_number="$(printf '%s' "$suffix" | tr -cd 'A-Za-z0-9')"
if [[ -n "$test_env_number" ]]; then
  echo "==> Writing .env.test (TEST_ENV_NUMBER=$test_env_number)"
  printf 'TEST_ENV_NUMBER=%s\n' "$test_env_number" > "$worktree_dir/.env.test"
  export TEST_ENV_NUMBER="$test_env_number"
fi

cd "$worktree_dir"

# Gems resolve from the shared Bundler path (same Gemfile.lock as the main
# worktree), so `bundle exec` works without a per-worktree `bundle install`, and
# node_modules is not needed to create the DB or run specs. Run bundle/yarn
# manually if a worktree ever needs assets/JS.

# Create + load the test DB explicitly (idempotent, independent of
# maintain_test_schema config). RAILS_ENV=test makes dotenv load .env.test so
# TEST_ENV_NUMBER resolves to the same suffix written above.
echo "==> Creating test database (RAILS_ENV=test)"
RAILS_ENV=test bundle exec rails db:create db:schema:load

# Verify the DB actually exists before declaring success.
if [[ -n "$test_env_number" ]]; then
  test_db="ambiki_test${test_env_number}"
  if ! psql -lqt | cut -d'|' -f1 | grep -qw "$test_db"; then
    die "test database $test_db was not created"
  fi
fi

echo "==> Done. Worktree ready:"
echo "    cd $worktree_dir"

# Start (or switch to) a tmux session rooted at the new worktree.
if command -v tmux >/dev/null 2>&1; then
  session_name="$repo_name-$suffix"
  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    echo "==> Starting tmux session $session_name"
    tmux new-session -d -s "$session_name" -c "$worktree_dir"
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session_name"
  else
    tmux attach -t "$session_name"
  fi
else
  echo "work-worktree: tmux not found; skipping session start" >&2
fi
