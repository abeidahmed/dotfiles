#!/usr/bin/env bash
set -euo pipefail

# work-worktree — create a git worktree for a branch and initialize it for local dev.
#
# Usage:
#   work-worktree                       adopt the current branch into a worktree
#   work-worktree <branch> [suffix]     create + init a worktree
#   work-worktree --remove [--force]    tear down the current worktree
#
# With no <branch> (adopt mode) the current branch is moved into its own
# worktree: the main worktree is switched back to the default branch (origin's
# HEAD, e.g. main/master) and the current branch is checked out in the new
# worktree instead. Lets you branch + commit in the main repo, then run
# `work-worktree` to peel that work off without hand-switching branches. Must be
# run from the main worktree on a clean tree (--force overrides the clean check).
#
# Creates a sibling worktree dir named "<repo>-<suffix>" next to the main repo,
# then: symlinks config/master.key from the main repo, bundle install,
# yarn install, and bundle exec rails db:test:prepare.
#
# --remove (run from inside a worktree) reverses that: drops the test DB
# (RAILS_ENV=test rails db:drop), removes the worktree via git, and kills its
# tmux session, switching the client to the first remaining session. It refuses
# on uncommitted changes unless --force is given.
#
# If <suffix> is omitted it is derived from the trailing digits of the branch
# name (e.g. aa/fix-scenario-042 -> 042), falling back to a sanitized branch
# basename. If the branch already exists it is checked out; otherwise it is
# created with -b.
#
# Run from anywhere inside the repo (main worktree or an existing worktree).

die() { echo "work-worktree: $*" >&2; exit 1; }

# Name the failing step on any abort instead of dying silently.
trap 'echo "work-worktree: FAILED near line $LINENO (see output above)" >&2' ERR

# Parse flags. --remove tears down the current worktree; --force allows removal
# despite uncommitted changes. Positional args are only used by the create path.
remove=0
force=0
positional=()
for arg in "$@"; do
  case "$arg" in
    --remove) remove=1 ;;
    --force)  force=1 ;;
    *)        positional+=("$arg") ;;
  esac
done
set -- "${positional[@]+"${positional[@]}"}"

# Locate the main worktree root via the shared git dir.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_root="$(dirname "$common_dir")"
repo_name="$(basename "$main_root")"
parent_dir="$(dirname "$main_root")"

# --remove: drop the test DB, remove this worktree, kill its tmux session.
if [[ "$remove" -eq 1 ]]; then
  worktree_dir="$(git rev-parse --show-toplevel)"
  [[ "$worktree_dir" != "$main_root" ]] || die "refusing to remove the main worktree"
  session_name="$(basename "$worktree_dir")"

  if [[ "$force" -ne 1 && -n "$(git -C "$worktree_dir" status --porcelain)" ]]; then
    die "worktree has uncommitted changes; re-run with --force"
  fi

  echo "==> Dropping test database (RAILS_ENV=test)"
  ( cd "$worktree_dir" && RAILS_ENV=test bundle exec rails db:drop ) \
    || echo "work-worktree: db:drop failed (already gone?), continuing" >&2

  echo "==> Removing worktree $worktree_dir"
  # Run from the main root: git refuses to remove a worktree from inside it.
  cd "$main_root"
  remove_args=()
  [[ "$force" -eq 1 ]] && remove_args+=(--force)
  git -C "$main_root" worktree remove "${remove_args[@]+"${remove_args[@]}"}" "$worktree_dir"

  # tmux teardown LAST: kill-session terminates this script's own pane, so switch
  # the client away first and kill the session as the final action.
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$session_name" 2>/dev/null; then
    target="$(tmux list-sessions -F '#{session_name}' | grep -vx "$session_name" | head -n1)"
    if [[ -n "${TMUX:-}" && -n "$target" ]]; then
      tmux switch-client -t "$target"
    elif [[ -z "$target" ]]; then
      echo "work-worktree: $session_name is the only session; killing it exits the tmux server" >&2
    fi
    tmux kill-session -t "=$session_name"
  fi

  exit 0
fi

# Adopt mode: no branch given. Take the current branch, switch the main worktree
# back to the default branch, and hand the branch off to the new worktree below.
adopt=0
if [[ $# -eq 0 ]]; then
  adopt=1
  cur_root="$(git rev-parse --show-toplevel)"
  [[ "$cur_root" == "$main_root" ]] || die "adopt mode must run from the main worktree, not $cur_root"

  branch="$(git -C "$main_root" symbolic-ref --quiet --short HEAD)" \
    || die "detached HEAD; adopt mode needs a checked-out branch"

  # Resolve the default branch from origin's HEAD, falling back to main/master.
  default_branch="$(git -C "$main_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')" || default_branch=""
  if [[ -z "$default_branch" ]]; then
    for b in main master; do
      git -C "$main_root" show-ref --verify --quiet "refs/heads/$b" && { default_branch="$b"; break; }
    done
  fi
  [[ -n "$default_branch" ]] || die "could not determine the default branch"
  [[ "$branch" != "$default_branch" ]] || die "already on the default branch ($default_branch); nothing to adopt"

  if [[ "$force" -ne 1 && -n "$(git -C "$main_root" status --porcelain)" ]]; then
    die "main worktree has uncommitted changes; commit them or re-run with --force"
  fi

  echo "==> Switching main worktree back to $default_branch"
  git -C "$main_root" checkout "$default_branch"

  suffix=""
else
  branch="$1"
  suffix="${2:-}"
fi

# Derive a directory suffix if none was given.
if [[ -z "$suffix" ]]; then
  if [[ "$branch" =~ ([0-9]+)$ ]]; then
    suffix="${BASH_REMATCH[1]}"
  else
    suffix="$(basename "$branch" | tr -c 'A-Za-z0-9._-' '-')"
  fi
fi

worktree_dir="$parent_dir/$repo_name-$suffix"
[[ ! -e "$worktree_dir" ]] || die "target already exists: $worktree_dir"

master_key_src="$main_root/config/master.key"
[[ -e "$master_key_src" ]] || die "master.key not found at $master_key_src"

echo "==> Creating worktree $worktree_dir on branch $branch"
if git -C "$main_root" show-ref --verify --quiet "refs/heads/$branch"; then
  git -C "$main_root" worktree add "$worktree_dir" "$branch"
else
  git -C "$main_root" worktree add "$worktree_dir" -b "$branch"
fi

echo "==> Symlinking config/master.key"
# Absolute target on purpose: relative targets break because a worktree sits one
# directory deeper than a naive "../<repo>/config/master.key" assumes.
ln -sfn "$master_key_src" "$worktree_dir/config/master.key"

# Give this worktree its own test database + advisory-lock namespace via
# TEST_ENV_NUMBER (see config/initializers/sequenced.rb and the test: block in
# config/database.yml -> ambiki_test<TEST_ENV_NUMBER>). Written to .env.test so
# it applies only in the test environment, keeping development/production blank.
# Derived from the dir suffix (stripped to alphanumerics for a valid db name) so
# it is stable per worktree and unique across worktrees.
test_env_number="$(printf '%s' "$suffix" | tr -cd 'A-Za-z0-9')"
if [[ -n "$test_env_number" ]]; then
  echo "==> Writing .env.test (TEST_ENV_NUMBER=$test_env_number)"
  printf 'TEST_ENV_NUMBER=%s\n' "$test_env_number" > "$worktree_dir/.env.test"
  export TEST_ENV_NUMBER="$test_env_number"
fi

cd "$worktree_dir"

# Gems resolve from the shared Bundler path (same Gemfile.lock as the main
# worktree), so `bundle exec` works without a per-worktree `bundle install`, and
# node_modules is not needed to create the DB or run specs. Run bundle/yarn
# manually if a worktree ever needs assets/JS.

# Create + load the test DB explicitly (idempotent, independent of
# maintain_test_schema config). RAILS_ENV=test makes dotenv load .env.test so
# TEST_ENV_NUMBER resolves to the same suffix written above.
echo "==> Creating test database (RAILS_ENV=test)"
RAILS_ENV=test bundle exec rails db:create db:schema:load

# Verify the DB actually exists before declaring success.
if [[ -n "$test_env_number" ]]; then
  test_db="ambiki_test${test_env_number}"
  if ! psql -lqt | cut -d'|' -f1 | grep -qw "$test_db"; then
    die "test database $test_db was not created"
  fi
fi

echo "==> Done. Worktree ready:"
echo "    cd $worktree_dir"

# Start (or switch to) a tmux session rooted at the new worktree.
if command -v tmux >/dev/null 2>&1; then
  session_name="$repo_name-$suffix"
  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    echo "==> Starting tmux session $session_name"
    tmux new-session -d -s "$session_name" -c "$worktree_dir"
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session_name"
  else
    tmux attach -t "$session_name"
  fi
else
  echo "work-worktree: tmux not found; skipping session start" >&2
fi
